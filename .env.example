# Moonlight Wallet Environment Variables
# Copy this file to .env for local development

# Supabase API Configuration
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"

# Server-Side Supabase Configuration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_PROJECT_ID="your-supabase-project-id"

# Admin Authentication (Verified Server-Side Only)
# ADMIN_ACCESS_CODE="4336"
# ADMIN_SESSION_SECRET="your-32-byte-secret"

# Local Development & Testing Credentials
VITE_DEV_LOGIN_EMAIL=lucianfereldenlord@gmail.com
VITE_DEV_LOGIN_PASSWORD=12345678

# Resend Transactional Email Configuration (Server-Side / Edge Function Only)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="Moonlight <onboarding@resend.dev>"
APP_URL="https://moonlight-wallet.lovable.app"


